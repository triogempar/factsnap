# Fireworks AI — https://app.fireworks.ai/ (OpenAI-compatible inference)
FIREWORKS_API_KEY=

# Optional. Defaults to DeepSeek V4.1 Flash on Fireworks serverless.
# FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Optional. DeepSeek V4.1 reasons by default; "none" keeps checks fast and cheap.
# Use "low" if verdicts feel too shallow.
# FIREWORKS_REASONING_EFFORT=none

# Exa — https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Optional search type: auto (default) or lite (cheaper, cached pages only).
# EXA_SEARCH_TYPE=auto

# Optional. Checks allowed per IP per hour on this server instance (1–60, default 12).
# FACTSNAP_RATE_LIMIT=12
